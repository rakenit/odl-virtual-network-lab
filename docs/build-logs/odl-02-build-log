# Steps to build odl-02 docker container on prod-01 server. It is assumed that prod-01 has docker installed and the docker image and 
networks have been created. See prod-01-build-log file for more details.
# The container will have just one interface. The interface is connected to the mgmt network - net-172-20-254-23 
# This ODL container is used to interact with network nodes using Netconf southbound plugin
# All the network nodes are netconf enabled and listen on default port 830
# We use ODl Nitrogen SR3 image as there is an issue with Netconf plugin on the Oxygen release.
# We will launch the container, attach them to appropriate networks,  and install required ODL packages.

# Launch the container and attach to mgmt network. --cap-add NET_ADMIN permits container network config to be changed.

sudo docker run --cap-add NET_ADMIN -itd --name odl-02 --network=net-172-20-254-23 --ip 172.20.254.225 --hostname odl-02 --dns 8.8.8.8 odl:nitrogen-k073

# Verify the container is running
sudo docker container  ls -a
sudo docker inspect odl-02
sudo docker exec -it odl-02 sh
ifconfig
ip route 
ping 172.20.254.1
top

# verify ssh access to the container 
ssh root@172.20.254.225

# odl karaf ssh shell listens by default on port 8101. It can be accessed in two ways. 
#  1. SSH to the container and connect locally
	ssh root@172.20.254.225
        run the client script -  /opt/odl-nitrogen/bin/client 
	
# 2. Remotely by using SSH to odl karaf directly on port 8101. Use the locally configured Karaf credentials.
	
	ssh karaf@172.20.254.225 -p 8101
	
# Note: use logout or CTRL+D to disconnect from the odl karaf shell.

# We will now install the required southbound plugins from the odl-karaf console.
	
#Install ODL dlux core module and basic apps. 

	feature:install odl-dlux-core odl-dluxapps-topology odl-dluxapps-nodes odl-dluxapps-yangui odl-dluxapps-yangutils odl-mdsal-apidocs odl-restconf 
	

	Verification: http://172.20.254.225:8181/index.html U:<controller-user> P:<controller-password>

 
	
