Install qemu-2.12.0

cd ~/Downloads/qemu

wget https://download.qemu.org/qemu-2.12.0.tar.xz

tar xvf qemu-2.12.0.tar.xz

sudo vi include/net/net.h
 - At the bottom, change the value of "#define MAX_NICS" to 128
 - save and exit the file

