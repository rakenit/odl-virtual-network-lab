Install Ubuntu 16.04.2 LTS Server with 1 Mgmt and 4 Data Interfaces. Enable OpenSSH server. 
The server will boot up with a DHCP assigned IP

# Install updates and packages. The bridge-utils package is required to enable bridging for the management network.

sudo apt-get install && sudo apt-get update && sudo apt-get upgrade
sudo apt-get install wireshark curl git bridge-utils

# Add the follow config to /etc/network/interfaces file. You can use ifconfig -a to list all the interfaces. 
# Change the interface name to match what is on the host.

# To lab Mgmt Network.
auto ens32
iface ens32 inet manual

# Underlay to communicate with other hosts.
auto ens33
iface ens33 inet static
  address 10.1.1.4
  netmask 255.255.255.0

auto ens34
iface ens35 inet manual

auto ens35
iface ens35 inet manual

auto ens36
iface ens36 inet manual

# Auto create br-mgmt0. add mgmt interface - ens32. This also automatically creates and brings br-mgmt0 interface up. Need bridge-utils pkg installed.
auto br-mgmt0
iface br-mgmt0  inet static
  address 172.20.254.174
  netmask 255.255.254.0
  gateway 172.20.254.1
  dns-nameservers 8.8.8.8 8.8.4.4
#static route example
# post-up route add -net 10.0.0.0 netmask 255.0.0.0 gw 10.18.44.1
  bridge_ports ens32
  bridge_stp off
  bridge_fd 0
  bridge_maxwait 0

