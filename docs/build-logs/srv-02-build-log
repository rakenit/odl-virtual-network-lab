### QEMU can create TAP interfaces but will not bring them up.
### we use two sets of ifup and ifdown scripts with qemu to bring the tap interfaces up.
### 1. Use tap-mgmt-up and tap-mgmt-down to bring the management TAP interface up and assign it to the management bridge, br-mgmt0, created earlier.
### 2. Use tap-data-up and tap-data-down to bring data tap interface up. These interfaces will be used by OpenFlow switches later.

### create tap-mgmt scripts ###
mkdir BBLAB
cd BBLAB
mkdir new_xr

cd /home/lab/BBLAB/
 nano tap-mgmt-ifup 

#!/bin/sh
switch='br-mgmt0'
/sbin/ifconfig $1 0.0.0.0 up
brctl addif ${switch} $1

 nano tap-mgmt-ifdown

#!/bin/sh
switch='br-mgmt0'
/sbin/ifconfig $1 0.0.0.0 down
brctl delif ${switch} $1

# Make both files executable
 chmod +x /home/lab/BBLAB/tap-mgmt-ifup /home/lab/BBLAB/tap-mgmt-ifdown

