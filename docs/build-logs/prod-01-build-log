# Build docker network environment # 

### We will be creating 3 docker networks, net-172-20-254-23 will connect to the lab mgmt network. 
### net-10-99-201-24 and net-10-99-202-24 are used to connect with the backbone RRRs
### We will be using docker network type - macvlan so that the containers can communicate with the network natively.
## We restrict the ip range for the networks to a single ip to prevent dynamic ip assignments to containers.
## We manually assign container ip addresses.
## It's not possible to  stop docker from assigning gw ip to a container.
## A docker container can be attached to only one network at the time of creation. More networks can be added later.


# Create the  networks 

sudo docker network create -d macvlan  \
  --subnet=172.20.254.0/23  --ip-range=172.20.254.221/32 --gateway 172.20.254.1 \
  -o parent=ens32 net-172-20-254-23

# Note: we explicitly set the gw address for the mgmt network.

sudo docker network create -d macvlan  \
  --subnet=10.99.201.0/24 --ip-range=10.99.201.254/32 \
  -o parent=ens33 net-10-99-201-24

sudo docker network create -d macvlan  \
  --subnet=10.99.202.0/24  --ip-range=10.99.202.254/32 \
  -o parent=ens34 net-10-99-202-24
  
# We do not use the gateway option for the net-10 networks. Docker will use the only available ip in the range as the gateway ip for the
# containers attached to those networks. Docker will configure gateways for all attached networks and one of the default gateways will be used as the GW.
# Multi-homed containers may require default gw re-configuration to use the correct network.
# We manually reconfigure the default gateway form multi-homed containers after creation.
  
